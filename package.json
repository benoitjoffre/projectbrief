{
  "name": "projectbrief",
  "version": "1.0.0",
  "main": "index.js",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/api",
    "test": "npm run test -w apps/api && npm run test -w apps/web",
    "db:seed": "npm run db:seed -w apps/api"
  },
  "keywords": [],
